{
  "name": "teste-voto",
  "version": "0.1.0",
  "description": "Um quiz imparcial para ajudar os eleitores a descobrir qual candidato combina com eles.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "start": "vite",
    "api": "node --experimental-sqlite --experimental-strip-types server/index.ts",
    "ingest": "node --experimental-sqlite --experimental-strip-types scripts/ingest.ts",
    "test": "node --experimental-sqlite --experimental-strip-types --test scripts/csv.test.ts scripts/normalize.test.ts scripts/repository.test.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:distribution": "node --experimental-strip-types scripts/check-distribution.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}