{
  "name": "teste-voto",
  "version": "0.1.0",
  "description": "Um quiz imparcial para ajudar os eleitores a descobrir qual candidato combina com eles.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "start": "node --experimental-strip-types scripts/dev.ts",
    "api": "node --experimental-sqlite --experimental-strip-types server/index.ts",
    "ingest": "node --experimental-sqlite --experimental-strip-types scripts/ingest.ts",
    "sync:incumbents": "node --experimental-sqlite --experimental-strip-types scripts/sync-incumbents.ts",
    "sync:parliament": "node --experimental-sqlite --experimental-strip-types scripts/sync-parliament.ts",
    "sync:history": "node --experimental-sqlite --experimental-strip-types scripts/sync-history.ts",
    "sync:votacoes": "node --experimental-sqlite --experimental-strip-types scripts/sync-votacoes.ts",
    "rank:votacoes": "node --experimental-sqlite --experimental-strip-types scripts/rank-votacoes.ts",
    "classify:votacoes": "node --experimental-sqlite --experimental-strip-types scripts/classify-votacoes.ts",
    "build:quiz": "node --experimental-sqlite --experimental-strip-types scripts/build-quiz-positions.ts",
    "editorial:templates": "node --experimental-sqlite --experimental-strip-types scripts/editorial-templates.ts",
    "export:ficha": "node --experimental-sqlite --experimental-strip-types scripts/export-ficha.ts",
    "publish:data": "node --experimental-sqlite --experimental-strip-types scripts/publish-data.ts",
    "test": "node --experimental-sqlite --experimental-strip-types --test scripts/csv.test.ts scripts/normalize.test.ts scripts/repository.test.ts scripts/quiz-source.test.ts scripts/quiz-pipeline.test.ts scripts/scoring.test.ts scripts/search.test.ts scripts/complementar.test.ts scripts/identity.test.ts scripts/parliament.test.ts scripts/history.test.ts scripts/elections.test.ts scripts/router.test.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "check:distribution": "node --experimental-sqlite --experimental-strip-types scripts/check-distribution.ts",
    "build:ssr": "vite build --ssr src/entry-server.tsx",
    "build:pages": "node --experimental-sqlite --experimental-strip-types scripts/prerender.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
