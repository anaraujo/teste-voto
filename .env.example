# Exemplo de configuração por variáveis de ambiente.
# Copie para .env se quiser customizar:

# Diretório de dados locais (zips, banco SQLite e fotos).
# DATA_DIR=data

# Endpoint local do llama.cpp para classificar votações do quiz
# (API compatível com OpenAI). Opcional: QUIZ_LLM_API_KEY e QUIZ_LLM_MODEL.
# QUIZ_LLM_BASE_URL=http://127.0.0.1:8080

# Porta da API HTTP (node:http). O Vite (app) usa a porta 2026.
# PORT=2027

# Alvo do proxy do Vite para a API. Útil ao rodar a API em outra máquina.
# API_TARGET=http://localhost:2027

# --- Deploy GCP (scripts/publish-data.ts) ---

# Bucket GCS de dados do runtime (obrigatório para npm run publish:data).
# O prefixo gs:// é opcional; o script aceita também o nome puro.
# GCS_BUCKET=gs://meu-projeto-dados

# Serviço Cloud Run e região usados pela flag --reload.
# CLOUD_RUN_SERVICE=teste-voto
# CLOUD_RUN_REGION=southamerica-east1

# --- Container / Cloud Run ---
# SERVE_STATIC=true   # servir dist/ pelo mesmo processo (SPA + API + fotos)
# DATA_DIR=/app/data  # destino da cópia do entrypoint (default local: data)
