# Exemplo de configuração por variáveis de ambiente.
# Copie para .env se quiser customizar:

# Diretório de dados locais (zips, banco SQLite e fotos).
# DATA_DIR=data

# Porta da API HTTP (node:http). O Vite (app) usa a porta 2026.
# PORT=2027

# Alvo do proxy do Vite para a API. Útil ao rodar a API em outra máquina.
# API_TARGET=http://localhost:2027

# Domínio público, usado no build estático: canonical, og:url, sitemap.xml e
# robots.txt. Padrão: http://localhost:2026
# SITE_URL=https://exemplo.com.br